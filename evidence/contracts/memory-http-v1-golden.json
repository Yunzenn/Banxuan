  "errors": [
    {
      "name": "not_found",
      "status": 404,
      "body": { "code": "MEMORY_NOT_FOUND", "message": "no memory with id m9", "id": "m9" },
      "expectException": "MemoryNotFoundException"
    },
    {
      "name": "not_confirmed",
      "status": 400,
      "body": {
        "code": "MEMORY_NOT_CONFIRMED",
        "message": "memory m1 is STAGED, expected CONFIRMED",
        "id": "m1",
        "status": "STAGED"
      },
      "expectException": "MemoryNotConfirmedException"
    },
    {
      "name": "not_stageable",
      "status": 400,
      "body": {
        "code": "MEMORY_NOT_STAGEABLE",
        "message": "memory m1 is CONFIRMED, expected STAGED",
        "id": "m1",
        "status": "CONFIRMED"
      },
      "expectException": "MemoryNotStageableException"
    },
    {
      "name": "invalid_transition",
      "status": 409,
      "body": {
        "code": "INVALID_TRANSITION",
        "message": "memory m1 is REJECTED and cannot become CONFIRMED",
        "id": "m1",
        "fromStatus": "REJECTED",
        "toStatus": "CONFIRMED"
      },
      "expectException": "MemoryTransitionException"
    },
    {
      "name": "not_editable",
      "status": 409,
      "body": {
        "code": "MEMORY_NOT_EDITABLE",
        "message": "memory m1 is REJECTED, which cannot be edited",
        "id": "m1",
        "status": "REJECTED"
      },
      "expectException": "MemoryNotEditableException"
    },
    {
      "name": "type_mismatch",
      "status": 400,
      "body": {
        "code": "MEMORY_TYPE_MISMATCH",
        "message": "memory m1 is PROFILE but the edit is for EVENT",
        "id": "m1",
        "expectedType": "EVENT",
        "actualType": "PROFILE"
      },
      "expectException": "MemoryTypeMismatchException"
    },
    {
      "name": "identity_conflict",
      "status": 409,
      "body": {
        "code": "MEMORY_IDENTITY_CONFLICT",
        "message": "memory m1 would become the same fact as m2",
        "id": "m1",
        "conflictingId": "m2",
        "characterScope": "xiaozhi",
        "identityKey": "food.like"
      },
      "expectException": "MemoryIdentityConflictException"
    },
    {
      "name": "unauthorised",
      "status": 401,
      "body": { "code": "UNAUTHORIZED", "message": "token required" },
      "expectException": "MemoryTransportException"
    },
    {
      "name": "wrong_subject",
      "status": 403,
      "body": { "code": "FORBIDDEN", "message": "token subject does not match device" },
      "expectException": "MemoryTransportException"
    },
    {
      "name": "unrecognised_code_fails_closed",
      "status": 409,
      "body": { "code": "SOMETHING_NEW", "message": "a code this client does not know" },
      "expectException": "MemoryTransportException"
    }
  ],
  "normalization": [
    {
      "name": "offset_instant_re_emits_as_utc",
      "input": "2026-09-27T18:00:00+08:00",
      "output": "2026-09-27T10:00:00Z"
    },
    {
      "name": "milliseconds_are_preserved",
      "input": "2026-10-05T07:00:37.123Z",
      "output": "2026-10-05T07:00:37.123Z"
    }
  ]
