<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#315D9A</item>
        <item name="android:navigationBarColor">#FAF8F5</item>
        <item name="android:statusBarColor">#FAF8F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Daylight Home shares the system's native light controls with Settings. -->
    <style name="CompanionTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#FAF8F5</item>
        <item name="android:colorBackground">#FAF8F5</item>
        <item name="android:navigationBarColor">#FAF8F5</item>
        <item name="android:statusBarColor">#FAF8F5</item>
        <item name="android:colorAccent">#476782</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
