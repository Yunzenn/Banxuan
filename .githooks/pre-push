#!/bin/sh
# Privacy guard for the destination remote.
#
# Only the commits this push would newly introduce to the destination remote are validated, plus
# annotated-tag identity. Already-published ancestors are NOT revalidated: a commit that is already on
# the remote cannot be unpublished by rejecting a later push, and re-validating the whole ancestry makes
# every branch based on an existing history permanently unpushable.
#
# This is a local safeguard. It cannot see a server-side squash merge, which creates a new commit on
# GitHub and sets its author from the account. Account-level Email privacy is the first line of defence
# for pull-request merges; this hook is the second. Do not bypass it.
set -eu

expected='yunzenn|209125778+Yunzenn@users.noreply.github.com|yunzenn|209125778+Yunzenn@users.noreply.github.com'
expected_tag='yunzenn|<209125778+Yunzenn@users.noreply.github.com>'
zero='0000000000000000000000000000000000000000'

remote_name="${1:-origin}"

while read -r local_ref local_oid remote_ref remote_oid; do

    # Branch/tag deletion: nothing new is introduced.
    if [ "$local_oid" = "$zero" ]; then
        continue
    fi

    if [ "$remote_oid" != "$zero" ]; then
        # Existing ref may merge another already-published branch (e.g. GitHub's main squash).
        # Validate only commits new to this destination REMOTE, not just new to this branch.
        commits=$(git rev-list "$remote_oid..$local_oid" --not --remotes="$remote_name")
    else
        # New destination ref: reachable here but not already published by THIS remote.
        # Deliberately not `--not --remotes`, which would trust every other remote and let an
        # unpublished commit through if some unrelated remote happens to contain it.
        commits=$(git rev-list "$local_oid" --not --remotes="$remote_name")
    fi

    for commit in $commits; do
        identity=$(git show -s --format='%an|%ae|%cn|%ce' "$commit")
        if [ "$identity" != "$expected" ]; then
            echo "Push blocked: unpublished commit $commit has non-private identity: $identity" >&2
            exit 1
        fi
    done

    if [ "$(git cat-file -t "$local_oid")" = 'tag' ]; then
        tag_identity=$(git for-each-ref --format='%(taggername)|%(taggeremail)' "$local_ref")
        if [ "$tag_identity" != "$expected_tag" ]; then
            echo 'Push blocked: tag metadata does not use yunzenn privacy identity.' >&2
            exit 1
        fi
    fi
done

exit 0
